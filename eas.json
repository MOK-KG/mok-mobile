{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dashboard.olympic.kg/api"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://dashboard.olympic.kg/api"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6834389664",
        "appleTeamId": "CSJMBZC2C9"
      }
    }
  }
}
