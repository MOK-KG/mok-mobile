{
  "permissions": {
    "allow": [
      "Bash(pnpm run *)",
      "Bash(pnpm lint)",
      "Bash(pnpm format)",
      "Bash(pnpm test)",
      "Bash(pnpm test *)",
      "Bash(pnpm build)",
      "Bash(pnpm typecheck)",
      "Bash(npx *)",
